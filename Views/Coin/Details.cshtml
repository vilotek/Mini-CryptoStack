@model Coin
@inject Microsoft.AspNetCore.Identity.SignInManager<ApplicationUser> SignInManager
@{
    ViewData["Title"] = $"{Model.Symbol} - {Model.Name}";
    var latest = ViewBag.Latest as PricePoint;
    var pointsCount = (int)(ViewBag.PointsCount ?? 0);
    var holding = ViewBag.Holding as Holding;
    var balance = (decimal)(ViewBag.Balance ?? 0m);
    var isLoggedIn = SignInManager.IsSignedIn(User);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Symbol" width="48" height="48" class="me-3" />
        }
        <div>
            <h1 class="mb-0">@Model.Symbol</h1>
            <small class="text-muted">@Model.Name</small>
        </div>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">← Powrót</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <small class="text-muted">Aktualna cena</small>
                <div class="fs-3 fw-semibold">@(latest is null ? "—" : $"${latest.Price:N4}")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <small class="text-muted">Zmiana 24h</small>
                @if (latest?.Change24h is not null)
                {
                    var cls = latest.Change24h >= 0 ? "text-success" : "text-danger";
                    var sign = latest.Change24h >= 0 ? "+" : "";
                    <div class="fs-3 fw-semibold @cls">@sign@latest.Change24h.Value.ToString("N2")%</div>
                }
                else
                {
                    <div class="fs-3">—</div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <small class="text-muted">Punktów cenowych</small>
                <div class="fs-3 fw-semibold">@pointsCount</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <strong>Historia ceny</strong>
                @if (pointsCount > 0)
                {
                    <select id="rangeSelect" class="form-select form-select-sm w-auto">
                        <option value="24h">Ostatnie 24h</option>
                        <option value="7d">Ostatnie 7 dni</option>
                        <option value="30d">Ostatnie 30 dni</option>
                        <option value="90d">Ostatnie 90 dni</option>
                        <option value="all" selected>Cały okres</option>
                    </select>
                }
            </div>
            <div class="card-body">
                @if (pointsCount == 0)
                {
                    <p class="text-muted mb-0">Brak danych — system pobiera ceny automatycznie co kilka minut.</p>
                }
                else
                {
                    <div class="d-flex gap-4 mb-2 small text-muted">
                        <span>Min: <strong id="statMin" class="text-body">—</strong></span>
                        <span>Max: <strong id="statMax" class="text-body">—</strong></span>
                        <span>Zmiana w okresie: <strong id="statChange">—</strong></span>
                    </div>
                    <canvas id="priceChart" height="160"></canvas>
                    <p id="chartEmpty" class="text-muted mb-0 d-none">Brak punktów w wybranym okresie.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        @if (!isLoggedIn)
        {
            <div class="card">
                <div class="card-body">
                    <p>Aby handlować, <a asp-area="Identity" asp-page="/Account/Login">zaloguj się</a>
                       lub <a asp-area="Identity" asp-page="/Account/Register">zarejestruj</a>.</p>
                </div>
            </div>
        }
        else if (latest is null)
        {
            <div class="card"><div class="card-body text-muted">Brak ceny — handel nieaktywny.</div></div>
        }
        else
        {
            <div class="card mb-3">
                <div class="card-body">
                    <small class="text-muted">Twoje saldo USD</small>
                    <div class="fs-4 fw-semibold">$@balance.ToString("N2")</div>
                    @if (holding is not null)
                    {
                        <hr />
                        <small class="text-muted">Posiadasz</small>
                        <div class="fs-5">@holding.Quantity.ToString("N8") @Model.Symbol</div>
                        <small class="text-muted">Średnia cena zakupu: $@holding.AvgBuyPrice.ToString("N4")</small>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header text-success"><strong>Kup</strong></div>
                <div class="card-body">
                    <form asp-controller="Coin" asp-action="Buy" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <label class="form-label">Kwota w USD</label>
                            <input name="usdAmount" type="number" step="0.01" min="0.01"
                                   max="@balance.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                   class="form-control" required />
                            <small class="text-muted">Przy cenie $@latest.Price.ToString("N4") otrzymasz odpowiednią ilość.</small>
                        </div>
                        <button type="submit" class="btn btn-success w-100">Kup</button>
                    </form>
                </div>
            </div>

            @if (holding is not null && holding.Quantity > 0)
            {
                <div class="card">
                    <div class="card-header text-danger"><strong>Sprzedaj</strong></div>
                    <div class="card-body">
                        <form asp-controller="Coin" asp-action="Sell" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-2">
                                <label class="form-label">Ilość @Model.Symbol</label>
                                <input name="quantity" type="number" step="0.00000001" min="0.00000001"
                                       max="@holding.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       class="form-control" required />
                                <small class="text-muted">Max: @holding.Quantity.ToString("N8")</small>
                            </div>
                            <button type="submit" class="btn btn-danger w-100">Sprzedaj</button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    @if (pointsCount > 0)
    {
        <script>
            const coinId = @Model.Id;
            const symbol = '@Model.Symbol';
            let priceChart = null;

            const fmt = v => '$' + Number(v).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: v < 1 ? 6 : 2 });

            function updateStats(dataset) {
                const ys = dataset.map(d => d.y);
                const min = Math.min(...ys), max = Math.max(...ys);
                const first = ys[0], last = ys[ys.length - 1];
                const pct = first !== 0 ? ((last - first) / first) * 100 : 0;
                document.getElementById('statMin').textContent = fmt(min);
                document.getElementById('statMax').textContent = fmt(max);
                const chg = document.getElementById('statChange');
                const sign = pct >= 0 ? '+' : '';
                chg.textContent = sign + pct.toFixed(2) + '%';
                chg.className = pct >= 0 ? 'text-success' : 'text-danger';
            }

            async function loadChart(range) {
                const res = await fetch(`/Coin/ChartData/${coinId}?range=${range}`);
                const data = await res.json();
                const dataset = data.map(d => ({ x: d.t, y: d.p }));

                const canvas = document.getElementById('priceChart');
                const empty = document.getElementById('chartEmpty');
                if (priceChart) { priceChart.destroy(); priceChart = null; }

                if (dataset.length === 0) {
                    canvas.classList.add('d-none');
                    empty.classList.remove('d-none');
                    ['statMin', 'statMax', 'statChange'].forEach(id => document.getElementById(id).textContent = '—');
                    return;
                }
                canvas.classList.remove('d-none');
                empty.classList.add('d-none');
                updateStats(dataset);

                // Oś Y dociśnięta do realnego zakresu danych, żeby drobne ruchy ceny były widoczne
                const ys = dataset.map(d => d.y);
                const min = Math.min(...ys), max = Math.max(...ys);
                const pad = (max - min) * 0.12 || max * 0.01 || 1;

                // Kolor zależny od trendu w wybranym okresie
                const up = ys[ys.length - 1] >= ys[0];
                const color = up ? '#198754' : '#dc3545';
                const fillColor = up ? 'rgba(25,135,84,0.10)' : 'rgba(220,53,69,0.10)';

                priceChart = new Chart(canvas, {
                    type: 'line',
                    data: {
                        datasets: [{
                            label: symbol + ' / USD',
                            data: dataset,
                            borderColor: color,
                            backgroundColor: fillColor,
                            fill: true, tension: 0.25,
                            pointRadius: dataset.length > 60 ? 0 : 2,
                            pointHoverRadius: 4,
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        interaction: { mode: 'index', intersect: false },
                        scales: {
                            x: { type: 'time', time: { tooltipFormat: 'PPpp' } },
                            y: {
                                min: min - pad,
                                max: max + pad,
                                ticks: { callback: v => fmt(v) }
                            }
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: { callbacks: { label: c => fmt(c.parsed.y) } }
                        }
                    }
                });
            }

            const rangeSelect = document.getElementById('rangeSelect');
            rangeSelect.addEventListener('change', () => loadChart(rangeSelect.value));
            loadChart(rangeSelect.value);
        </script>
    }
}
